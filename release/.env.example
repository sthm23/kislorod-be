# Node.js environment
NODE_ENV=production
PORT=3000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_MINI_APP_URL=https://t.me/your_bot_name

# Database connection
# ВАЖНО для shared hosting (aHOST, cPanel):
# 1. Используйте localhost или 127.0.0.1 как host (НЕ внешний IP!)
# 2. Если пароль содержит специальные символы (&$;=*@#/\ пробелы),
#    их нужно URL-encode. Например: & → %26, $ → %24, ; → %3B
# Пример: password "a&b$c" → "a%26b%24c"
# Онлайн инструмент: https://www.urlencoder.org/
DATABASE_URL=postgresql://username:password@localhost:5432/database?schema=public

# Database SSL (set to 'true' only if your PostgreSQL server requires SSL)
# For aHOST and most shared hosting: set to 'false'
DB_SSL=false

# Optional: separate database credentials (not required if using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
PG_USER=username
PG_PASSWORD=password
PG_DB=database_name
